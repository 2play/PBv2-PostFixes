#!/bin/bash
# The PlayBox Project
# Copyright (C)2018-2026 2Play! (S.R.)
# 04.2026
# PlayBox Skyscraper BoxArt Wrapper with ES stop/start
# Watch a video demonstrating the artwork compositing features here: https://youtu.be/TIDD8EFSz50
# ReadThis For Extra help on manual scrapes: https://github.com/muldjord/skyscraper/blob/master/docs/ARTWORK.md
# And here https://github.com/muldjord/skyscraper/tree/master?tab=readme-ov-file

clear

# If EmulationStation is running, kill it first
stop_es() {
    clear
	echo "[Stopping EmulationStation...]"
	sleep 1
	
	# Stop ES
    pkill -f emulationstation
	
    while pgrep -f emulationstation >/dev/null; do
        sleep 2
    done

    # Extra delay to let esbgm service react
    sleep 1
}

start_es() {
    echo "[Starting EmulationStation...]"
    nohup emulationstation --no-splash 2>/dev/null &
    disown
}

check_and_run() {
    local bin="$1"
    shift
    local resolved
    resolved=$(command -v "$bin")
    if [[ -n "$resolved" && -x "$resolved" ]]; then
        "$resolved" "$@"
    else
        echo "[ERROR] $bin not found in PATH or not executable."
        sleep 2
    fi
}

stop_es
check_and_run ~/code/skysource/Skyscraper --help
	echo
	echo -e "\033[32mAlso check the --flags settings\033[0m!..."
	echo
check_and_run ~/code/skysource/Skyscraper --flags help
    echo -e "[OK \033[32mDONE\033[0m!...]"
    sleep 1
	echo
	read -n 1 -s -r -p "Press any key to continue..."
	echo
    
start_es
	